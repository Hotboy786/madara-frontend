SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVER-ONLY-SERVICE-ROLE-KEY
# Generate once; retain this key across every deployment.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROFILE_ENCRYPTION_KEY=YOUR-FERNET-KEY
ALLOWED_EMAILS=you@example.com,brother@example.com
# Optional: exact HTTPS origin of your existing Madara frontend.
ALLOWED_EMBED_ORIGINS=https://your-existing-panel.vercel.app
